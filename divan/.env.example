# ═══════════════════════════════════════════════════════════
#  دیوان — نمونه‌ی تنظیمات
#  این فایل را کپی کن به .env و مقادیر را پر کن.  (.env هرگز commit نمی‌شود)
# ═══════════════════════════════════════════════════════════

# ── کانال‌ها ──────────────────────────────────────────────
# توکن بات تلگرام از @BotFather
BOT_TOKEN=
# توکن بات بله (اختیاری — از داخل ایران باز است). BotFather داخل خود بله.
BALE_TOKEN=

# ── هوش مصنوعی (زنجیره‌ی fallback: Gemini → Groq) ─────────
# کلید اصلی: aistudio.google.com/apikey
GEMINI_API_KEY=
# کلید پشتیبان (توصیه‌شده): console.groq.com/keys
GROQ_API_KEY=

# ── دیتابیس و صف ──────────────────────────────────────────
POSTGRES_USER=divan
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=divan
DATABASE_URL=postgresql+asyncpg://divan:change_me_to_a_strong_password@db:5432/divan
REDIS_URL=redis://redis:6379/0

# ── شبکه (برای IP ایران؛ اگر VPN سراسری روشن است خالی بگذار) ─
# PROXY_URL=socks5://127.0.0.1:1080

# ── سقف مصرف داخلی (نه محدودیت گوگل) ─────────────────────
STT_TOTAL_MINUTES=3000

# ── ذخیره‌ی فایل (بخش ۲.۱ سند بازبینی) ───────────────────
# MVP: محلی. بعداً: s3
STORAGE_BACKEND=local
STORAGE_PATH=/data/attachments

# ── فایل بزرگ (اختیاری — Local Bot API Server، سقف را به 2GB می‌برد) ─
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# LOCAL_BOT_API=

# ── n8n (فاز ایجنت — فعلاً خالی) ─────────────────────────
# N8N_BASE_URL=
# N8N_API_KEY=
