# Vworld configuration — کپی کنید به .env و مقادیر واقعی را بگذارید.
# هیچ‌کدام اجباری نیستند؛ بدون این‌ها هم برنامه با دیتای نمونه کار می‌کند.

# --- LLM (اختیاری): پارس هوشمندتر و جمع‌بندی نتایج ---
ANTHROPIC_API_KEY=
VWORLD_MODEL=claude-sonnet-5

# --- Telegram: جستجوی کانال/گروه‌های عمومی ---
# از https://my.telegram.org بگیرید
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# --- Telegram bot: رابط چت (فرانت‌اند) ---
# از @BotFather بگیرید
TELEGRAM_BOT_TOKEN=

# --- Instagram ---
# روش رسمی (توصیه‌شده):
INSTAGRAM_ACCESS_TOKEN=
# روش غیررسمی (ممکن است خلاف قوانین اینستاگرام باشد):
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# --- LinkedIn + Web search (از طریق SerpAPI) ---
# از https://serpapi.com بگیرید
SERPAPI_KEY=
